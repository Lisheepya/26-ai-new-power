        "alpha": 0.0001,
        "batch_size": "auto",
        "beta_1": 0.9,
        "beta_2": 0.999,
        "early_stopping": true,
        "epsilon": 1e-08,
        "hidden_layer_sizes": [
          32,
          16
        ],
        "learning_rate": "constant",
        "learning_rate_init": 0.001,
        "max_fun": 15000,
        "max_iter": 500,
        "momentum": 0.9,
        "n_iter_no_change": 20,
        "nesterovs_momentum": true,
        "power_t": 0.5,
